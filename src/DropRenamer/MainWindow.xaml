<Window x:Class="DropRenamer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DropRenamer.ViewModels"
        Title="ドロップリネーマー"
        Width="1040"
        Height="700"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">
    <Border Padding="7">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#155D36" />
                <GradientStop Offset="0.5" Color="#2E8B57" />
                <GradientStop Offset="1" Color="#72B86B" />
            </LinearGradientBrush>
        </Border.Background>
        <Grid Margin="14" Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock FontSize="25" FontWeight="SemiBold" Text="ドロップリネーマー" />
            <TextBlock Margin="0,4,0,0"
                       Foreground="#5C6573"
                       Text="ファイルをドロップして、フォルダー名＋連番に整えます。" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="12"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="#D8DEE8"
                    BorderThickness="1"
                    CornerRadius="7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="処理方法" />
                    <StackPanel Grid.Row="1" Margin="0,9,0,16">
                        <RadioButton x:Name="CopyRadio"
                                     Margin="0,4"
                                     Content="コピー"
                                     Checked="OperationRadio_Checked" />
                        <RadioButton x:Name="MoveRadio"
                                     Margin="0,4"
                                     Content="移動"
                                     Checked="OperationRadio_Checked" />
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="送り先フォルダー" />
                        <Border Grid.Row="1"
                                Margin="0,7,0,0"
                                Padding="8"
                                Background="White"
                                BorderBrush="#D8DEE8"
                                BorderThickness="1"
                                CornerRadius="4">
                            <TextBlock x:Name="DestinationText"
                                       Foreground="#3C4655"
                                       Text="送り先が選択されていません"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </Border>
                        <TreeView x:Name="FolderTree"
                                  Grid.Row="2"
                                  Margin="0,9,0,0"
                                  ItemsSource="{Binding RootFolders}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  SelectedItemChanged="FolderTree_SelectedItemChanged">
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type vm:FolderNode}" ItemsSource="{Binding Children}">
                                    <TextBlock Text="{Binding DisplayName}" />
                                </HierarchicalDataTemplate>
                            </TreeView.Resources>
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded"
                                            Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <Setter Property="IsSelected"
                                            Value="{Binding IsSelected, Mode=TwoWay}" />
                                    <EventSetter Event="Expanded" Handler="FolderItem_Expanded" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                        </TreeView>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="135" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="DropArea"
                        Grid.Row="0"
                        Background="#EFF5FF"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="2"
                        CornerRadius="8">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Text="ここにファイルをドロップ" />
                        <TextBlock Margin="0,7,0,0"
                                   Foreground="#5C6573"
                                   Text="フォルダーは追加できません" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2"
                        BorderBrush="#D8DEE8"
                        BorderThickness="1"
                        CornerRadius="7">
                    <DataGrid x:Name="PreviewGrid"
                              ItemsSource="{Binding FileItems}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              SelectionChanged="PreviewGrid_SelectionChanged"
                              PreviewMouseLeftButtonDown="PreviewGrid_PreviewMouseLeftButtonDown"
                              Sorting="PreviewGrid_Sorting"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Resources>
                            <Style x:Key="PreviewCellStyle" TargetType="{x:Type DataGridCell}">
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background"
                                                Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <Style x:Key="ExcludedPreviewCellStyle"
                                   BasedOn="{StaticResource PreviewCellStyle}"
                                   TargetType="{x:Type DataGridCell}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}"
                                                 Value="対象外：コピー元と送り先が同じです">
                                        <Setter Property="Background" Value="#FFFFE5E5" />
                                    </DataTrigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background"
                                                Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.CellStyle>
                            <StaticResource ResourceKey="PreviewCellStyle" />
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="OriginalNameColumn"
                                                Width="220"
                                                Header="元のファイル名"
                                                Binding="{Binding OriginalName}"
                                                CanUserSort="True"
                                                SortMemberPath="OriginalName"
                                                CellStyle="{StaticResource ExcludedPreviewCellStyle}" />
                            <DataGridTextColumn Width="220"
                                                Header="変更後"
                                                Binding="{Binding NewName}"
                                                CanUserSort="False" />
                            <DataGridTextColumn Width="420"
                                                Header="保存場所"
                                                Binding="{Binding DestinationPath}"
                                                CanUserSort="False" />
                            <DataGridTextColumn Width="250"
                                                Header="状態"
                                                Binding="{Binding Status}"
                                                CanUserSort="False"
                                                CellStyle="{StaticResource ExcludedPreviewCellStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="SummaryText"
                       VerticalAlignment="Center"
                       Foreground="#5C6573"
                       Text="ファイルはまだ追加されていません。" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="ClearButton"
                        Margin="0,0,8,0"
                        Click="ClearButton_Click"
                        Content="一覧全体をクリア"
                        ToolTip="選択中の項目を一覧から削除します。未選択の場合は一覧全体を削除します。" />
                <Button x:Name="ExecuteButton"
                        MinWidth="120"
                        Foreground="White"
                        FontWeight="SemiBold"
                        Click="ExecuteButton_Click"
                        Content="実行"
                        IsEnabled="False">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="#155D36" />
                            <GradientStop Offset="0.55" Color="#2E8B57" />
                            <GradientStop Offset="1" Color="#72B86B" />
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>
            </StackPanel>
        </Grid>
        </Grid>
    </Border>
</Window>
