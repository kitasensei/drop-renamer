<Window x:Class="DropRenamer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DropRenamer.ViewModels"
        Title="Drop Renamer"
        Icon="DropRenamer.ico"
        Width="1180"
        Height="700"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">
    <Border Padding="14"
            Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,14"
                Padding="14,10"
                Background="#F5F5F5"
                BorderBrush="#C9C9C9"
                BorderThickness="1"
                CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock VerticalAlignment="Center"
                           FontSize="25"
                           FontWeight="SemiBold"
                           Text="Drop Renamer" />
                <StackPanel Grid.Column="2"
                            VerticalAlignment="Center">
                    <TextBlock Foreground="#3C4655"
                               Text="Drop files to rename them using the folder name and a sequence number." />
                    <TextBlock Margin="0,3,0,0"
                               FontSize="12"
                               Foreground="#6B7280"
                               Text="Folders cannot be added." />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="12"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="#D8DEE8"
                    BorderThickness="1"
                    CornerRadius="7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="Action" />
                    <StackPanel Grid.Row="1" Margin="0,9,0,16">
                        <RadioButton x:Name="CopyRadio"
                                     Margin="0,4"
                                     Content="Copy"
                                     Checked="OperationRadio_Checked" />
                        <RadioButton x:Name="MoveRadio"
                                     Margin="0,4"
                                     Content="Move"
                                     Checked="OperationRadio_Checked" />
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="Destination Folder" />
                        <Border Grid.Row="1"
                                Margin="0,7,0,0"
                                Padding="8"
                                Background="White"
                                BorderBrush="#D8DEE8"
                                BorderThickness="1"
                                CornerRadius="4">
                            <TextBlock x:Name="DestinationText"
                                       Foreground="#3C4655"
                                       Text="No destination folder selected"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </Border>
                        <TreeView x:Name="FolderTree"
                                  Grid.Row="2"
                                  Margin="0,9,0,0"
                                  ItemsSource="{Binding RootFolders}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  SelectedItemChanged="FolderTree_SelectedItemChanged">
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type vm:FolderNode}" ItemsSource="{Binding Children}">
                                    <TextBlock Text="{Binding DisplayName}" />
                                </HierarchicalDataTemplate>
                            </TreeView.Resources>
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded"
                                            Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <Setter Property="IsSelected"
                                            Value="{Binding IsSelected, Mode=TwoWay}" />
                                    <EventSetter Event="Expanded" Handler="FolderItem_Expanded" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                        </TreeView>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#D8DEE8"
                    BorderThickness="1"
                    CornerRadius="7">
                    <DataGrid x:Name="PreviewGrid"
                              ItemsSource="{Binding FileItems}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              SelectionChanged="PreviewGrid_SelectionChanged"
                              PreviewMouseLeftButtonDown="PreviewGrid_PreviewMouseLeftButtonDown"
                              Sorting="PreviewGrid_Sorting"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Resources>
                            <Style x:Key="PreviewCellStyle" TargetType="{x:Type DataGridCell}">
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Rename (same folder)">
                                        <Setter Property="Foreground" Value="#D97706" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Already renamed.">
                                        <Setter Property="Foreground" Value="#C62828" />
                                    </DataTrigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background"
                                                Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <Style x:Key="StatusCellStyle"
                                   TargetType="{x:Type DataGridCell}"
                                   BasedOn="{StaticResource PreviewCellStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Rename (same folder)">
                                        <Setter Property="Foreground" Value="#D97706" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background"
                                                Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.CellStyle>
                            <StaticResource ResourceKey="PreviewCellStyle" />
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="OriginalNameColumn"
                                                Width="1.15*"
                                                Header="Original Name"
                                                Binding="{Binding OriginalName}"
                                                CanUserSort="True"
                                                SortMemberPath="OriginalName" />
                            <DataGridTextColumn x:Name="NewNameColumn"
                                                Width="1.05*"
                                                Header="New Name"
                                                Binding="{Binding NewName}"
                                                CanUserSort="False" />
                            <DataGridTextColumn x:Name="DestinationColumn"
                                                Width="1.55*"
                                                Header="Destination"
                                                Binding="{Binding DestinationPath}"
                                                CanUserSort="False" />
                            <DataGridTextColumn x:Name="StatusColumn"
                                                Width="1.25*"
                                                Header="Status"
                                                Binding="{Binding Status}"
                                                CellStyle="{StaticResource StatusCellStyle}"
                                                CanUserSort="False" />
                        </DataGrid.Columns>
                    </DataGrid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="SummaryText"
                       VerticalAlignment="Center"
                       Foreground="#5C6573"
                       Text="No files have been added yet." />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="ClearButton"
                        Margin="0,0,8,0"
                        Click="ClearButton_Click"
                        Content="Clear Entire List"
                        ToolTip="Remove selected items from the list. If nothing is selected, clear the entire list." />
                <Button x:Name="ExecuteButton"
                        MinWidth="120"
                        Foreground="White"
                        FontWeight="SemiBold"
                        Click="ExecuteButton_Click"
                        Content="Run"
                        IsEnabled="False">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="#155D36" />
                            <GradientStop Offset="0.55" Color="#2E8B57" />
                            <GradientStop Offset="1" Color="#72B86B" />
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>
            </StackPanel>
        </Grid>
        </Grid>
    </Border>
</Window>
